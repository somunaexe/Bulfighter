# Copy this file to .env and fill in the real API Gateway URLs.
# .env is gitignored - these values are never committed.
# Note: since this is a client-side app, these still ship inside the built
# JS bundle - keeping them in .env only keeps them out of the git repo, it
# does not hide them from anyone inspecting the deployed site.
VITE_TOPICS_API_URL=
VITE_INTERESTS_API_URL=
VITE_CONSENTS_API_URL=
VITE_CONSENT_INVITE_API_URL=
VITE_ADMIN_AUTH_API_URL=
