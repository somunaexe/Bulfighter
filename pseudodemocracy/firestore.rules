rules_version = '2';

// Firestore security rules for the Pseudodemocracy online lobby/game.
// Paste this into Firebase Console -> Firestore Database -> Rules -> Publish.
// Not auto-deployed from this repo - Firebase rules are configured via the
// console or the Firebase CLI with project credentials this session doesn't
// have, so this file is the source of truth to copy from by hand.
//
// Model: anyone can read a game (so a join screen can show room state
// before you're a recognized player), but writes require anonymous auth,
// and a player can only ever write their own seat under players/{uid}.
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{roomCode} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.hostUid == request.auth.uid;
      allow delete: if false;

      match /players/{uid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
